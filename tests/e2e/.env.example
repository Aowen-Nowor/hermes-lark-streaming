# E2E test environment variables (copy to tests/e2e/.env and fill in)
#
# DEFAULT IS ALWAYS MOCK. Credentials alone never enable real Feishu calls.
# Real mode requires BOTH:
#   1. FEISHU_E2E_REAL=1 (exact value; true/yes/on are not accepted)
#   2. all three required credentials: APP_ID + APP_SECRET + CHAT_ID
# FEISHU_E2E_OPEN_ID is optional and is needed only for real private-chat tests.
#
# WARNING: Real Feishu e2e tests create actual cards and send a connectivity
# text message visible to users. Use a dedicated TEST bot and TEST group,
# NOT your production bot.

# ── Explicit real-mode opt-in (leave empty/0 for mock) ──
FEISHU_E2E_REAL=0

# ── Required for real mode (all 3 must be non-empty) ──

# 1. FEISHU_E2E_APP_ID — 飞书应用 App ID
#    飞书开放平台 https://open.feishu.cn/app → 测试应用 → 凭证与基础信息。
#    应用需开启机器人能力，并具有 im:message、im:message:send_as_bot、
#    cardkit:card、cardkit:card:streaming 等测试所需权限。
FEISHU_E2E_APP_ID=

# 2. FEISHU_E2E_APP_SECRET — 同一测试应用的 App Secret
FEISHU_E2E_APP_SECRET=

# 3. FEISHU_E2E_CHAT_ID — 测试群的 chat_id（群聊测试）
#    可从 message.receive 事件的 event.message.chat_id 获取，或通过
#    GET /open-apis/im/v1/chats 查询（应用需 im:chat:readonly 权限）。
FEISHU_E2E_CHAT_ID=

# ── Optional ──

# 测试用户 open_id；仅 real 私聊场景需要，格式 ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_E2E_OPEN_ID=

# Feishu API base URL（国内版默认，国际版用 https://open.larksuite.com/open-apis）
FEISHU_E2E_BASE_URL=https://open.feishu.cn/open-apis

# ── 运行方式 ──
#
# 本地 mock 模式（默认，无需配置）：
#   python -m pytest tests/e2e/ -v
#
# 强制 mock 模式（即使 .env 中存在凭证）：
#   FEISHU_E2E_REAL=0 python -m pytest tests/e2e/ -v
#
# 本地真飞书模式（会发送真实消息，父会话/CI 验收另有统一安排时请勿自行运行）：
#   1. 复制本文件到 tests/e2e/.env，填入 3 个必填值
#   2. 私聊场景另填 FEISHU_E2E_OPEN_ID
#   3. 将 FEISHU_E2E_REAL 改为 1
#   4. 运行：
#      set -a && source tests/e2e/.env && set +a
#      python -m pytest tests/e2e/ -v
#
# GitHub Actions 的 sync-from-gitee.yml 只运行 mock E2E，不应设置
# FEISHU_E2E_REAL=1；真实飞书验收不在该工作流中执行。
#
# ── 飞书 API 频率限制 ──
# CardKit API：API 级 1000 次/分 & 50 次/秒（流式模式豁免）；单卡片 10 次/秒。
# create/send/close 计入配额。runner 在 real 模式下进行帧间限速和测试间延迟。
# 超限错误码：CardKit 99991400（HTTP 429），IM 消息 230020。
